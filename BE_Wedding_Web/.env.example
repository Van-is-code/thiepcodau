# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Wedding_Web
DB_USER=postgres
DB_PASSWORD=@Van02092005

# Server Configuration
PORT=2000
NODE_ENV=development

# JWT Configuration
# BẮT BUỘC đổi. Tối thiểu 32 ký tự ngẫu nhiên — backend TỪ CHỐI khởi động ở
# production nếu vẫn để giá trị mẫu (xem src/config/env.js).
# Sinh nhanh:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=thay_bang_chuoi_ngau_nhien_toi_thieu_32_ky_tu
JWT_EXPIRE=7d

# Cloudinary Configuration
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# # Supabase Configuration (Optional)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_API_KEY=your_supabase_api_key_here
# USE_SUPABASE=false

# # Sepay Payment Integration
# # Get these from https://my.sepay.vn/
# SEPAY_API_URL=https://api.sepay.vn/v2
# MERCHANT_ID=your_sepay_merchant_id
# SECRET_KEY=your_sepay_secret_key

# # Sepay Bank Account Configuration (for QR code generation)
# # Bank code: MBBank, VCB, VIB, ACB, etc. (see https://qr.sepay.vn/banks.json)
# SEPAY_BANK_CODE=MBBank
# # Bank account number to receive payment
# SEPAY_ACCOUNT_NUMBER=your_account_number

# # Backward-compatible aliases (optional)
# SEPAY_API_KEY=your_secret_key
# SEPAY_PARTNER_CODE=your_merchant_id

# Slot Configuration
# Gia va goi slot duoc cau hinh tu FE

# Email Configuration (gui thiep moi qua Gmail - /api/mail/invitation)
# Dung App Password cua Gmail, khong phai mat khau dang nhap
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_PASSWORD=your_gmail_app_password

# Bật/tắt tính năng (mặc định tắt — dùng cơ chế admin cấp tài khoản)
ALLOW_PUBLIC_REGISTER=false
ENABLE_SLOT_PURCHASE=false

# Giới hạn sửa thiệp
INVITATION_MAX_EDITS=5
INVITATION_LOCK_DAYS=3

# ---------------------------------------------------------------------------
#  Hệ CTV — Thanh toán payOS (luồng cộng tác viên)
# ---------------------------------------------------------------------------
# Lấy tại https://my.payos.vn/  (Kênh thanh toán -> API)
PAYOS_CLIENT_ID=67c9a748-a571-4ea1-998a-ad7a5557b916
PAYOS_API_KEY=fa6e7a1a-a928-4810-b930-33f57c5bf711
PAYOS_CHECKSUM_KEY=5b96c820e1102229ca0d012118c41ae6108b17d460162d5ee66d64610d3752b1
# URL FE khách được điều hướng về sau khi thanh toán / huỷ (tuỳ chọn)
PAYOS_RETURN_URL=https://uyentoan.studio/pay/return
PAYOS_CANCEL_URL=https://uyentoan.studio/pay/cancel
# Hạn hiệu lực của 1 đơn / link thanh toán (giờ)
PAYOS_ORDER_TTL_HOURS=24
# CHỈ DÙNG DEV/TEST: giả lập payOS (không gọi API thật, không verify chữ ký webhook).
# Mặc định false. TUYỆT ĐỐI không bật ở production.
PAYOS_MOCK=false

# URL FE để dựng link trang thanh toán công khai /pay/:token
FRONTEND_URL=http://localhost:2001

# ---------------------------------------------------------------------------
#  Rút tiền tự động (tạo phiếu rút theo lịch tuần; admin vẫn duyệt & chuyển tay)
# ---------------------------------------------------------------------------
AUTO_PAYOUT_ENABLED=false
# Chu kỳ quét (ms) — mặc định 15 phút. Cũng là chu kỳ kiểm bất biến ví.
AUTO_PAYOUT_INTERVAL_MS=900000

# ---------------------------------------------------------------------------
#  Thông báo Telegram — 4 bot riêng biệt (mỗi bot 1 nhiệm vụ)
#  chat_id: nhắn @userinfobot để lấy user ID của bạn (số dương). Nhắn riêng
#  từng bot 1 câu trước (bấm START) rồi mới nhận được thông báo.
#  Nhiều người nhận: ngăn cách bằng dấu phẩy, vd 111111,222222
# ---------------------------------------------------------------------------
TELEGRAM_ENABLED=true

# Bot 1 — Lỗi hệ thống / cảnh báo
TELEGRAM_ALERT_BOT_TOKEN=8918561151:AAE9IozqlD1dbaE9k9ZtLRL7Omv1ozVDGyE
TELEGRAM_ALERT_CHAT_ID=2006511331

# Bot 2 — Đơn hàng & thanh toán
TELEGRAM_PAYMENT_BOT_TOKEN=8372749777:AAH__5fwzJQzf1ke77Ax5-owD1M_E1BBlVw
TELEGRAM_PAYMENT_CHAT_ID=2006511331

# Bot 3 — Phiếu rút tiền
TELEGRAM_PAYOUT_BOT_TOKEN=8842127293:AAF_quK3aAhUY3uzePkDsSDqkrlmF0aEIIA
TELEGRAM_PAYOUT_CHAT_ID=2006511331

# Bot 4 — Tài khoản khách (tạo / kích hoạt)
TELEGRAM_CUSTOMER_BOT_TOKEN=8866391681:AAHjSmE51Vd7rd0xiOfOo-URnlS_68FGBN4
TELEGRAM_CUSTOMER_CHAT_ID=2006511331

# (tuỳ chọn) nếu gửi vào topic của 1 supergroup thay vì chat riêng
# TELEGRAM_ALERT_THREAD_ID=
# TELEGRAM_PAYMENT_THREAD_ID=
# TELEGRAM_PAYOUT_THREAD_ID=
# TELEGRAM_CUSTOMER_THREAD_ID=

# (tuỳ chọn) chống spam kênh Lỗi: bỏ qua lỗi trùng nội dung trong khoảng này (ms)
# TELEGRAM_ALERT_DEDUP_MS=300000
# TELEGRAM_TZ=Asia/Ho_Chi_Minh

# ===========================================================================
#  Cloudflare R2 — kho ảnh cưới + CDN
# ===========================================================================
# Không cấu hình -> tự động lưu vào đĩa local (uploads/), hệ thống vẫn chạy.
# Lấy tại: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
STORAGE_DRIVER=local                     # r2 | local | (bỏ trống = tự chọn)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=thiepcodau-media
# # Domain công khai của bucket (R2 -> Settings -> Public access -> Custom Domain).
# # ĐÂY CHÍNH LÀ CDN: Cloudflare cache ảnh ở ~300 điểm trên toàn cầu, khách mời ở
# # Hải Phòng hay Sài Gòn đều lấy ảnh từ điểm gần nhất.
# R2_PUBLIC_BASE_URL=https://cdn.your-domain.com
# # URL công khai của chính backend — dùng dựng link ảnh khi chạy chế độ local.
# API_PUBLIC_URL=https://api.your-domain.com

# Giới hạn ảnh
MAX_IMAGE_BYTES=15728640             # 15MB
MAX_AUDIO_BYTES=26214400             # 25MB
MAX_IMAGES_PER_INVITATION=60

# ===========================================================================
#  payOS — CHI HỘ (Payouts): chuyển hoa hồng về tài khoản ngân hàng CTV
# ===========================================================================
# Khác với PAYOS_* ở trên (dùng để THU tiền vào). Chi hộ cần kênh + khoá riêng.
# Lấy tại https://my.payos.vn/ -> Chi hộ -> API
PAYOS_PAYOUT_CLIENT_ID=
PAYOS_PAYOUT_API_KEY=
PAYOS_PAYOUT_CHECKSUM_KEY=
PAYOS_PAYOUT_BASE_URL=https://api-merchant.payos.vn
# CHỈ DÙNG DEV/TEST: giả lập, không gọi API thật, không verify chữ ký webhook.
PAYOS_PAYOUT_MOCK=false
# Chế độ duyệt phiếu rút mặc định: manual (admin tự chuyển) | payos (chi hộ tự động)
PAYOUT_MODE=manual
# Webhook chi hộ cần khai ở payOS: https://api.your-domain.com/api/payments/payos/payout-webhook

# ===========================================================================
#  Bảo mật
# ===========================================================================
# Danh sách origin được phép gọi API, cách nhau bằng dấu phẩy.
# BẮT BUỘC ở production — thiếu thì backend từ chối khởi động.
CORS_ORIGINS=https://thiepcuoi.me,https://www.thiepcuoi.me
# Số lớp proxy phía trước (nginx=1, nginx+Cloudflare=2). Sai số này thì rate limit
# đếm nhầm IP của proxy thay vì IP thật của người dùng.
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=256kb
MIN_PASSWORD_LENGTH=8

# Giới hạn tần suất (số lần / cửa sổ thời gian)
RATE_LIMIT_AUTH=10                   # đăng nhập — 15 phút
RATE_LIMIT_PUBLIC_WRITE=20           # lời chúc / xác nhận tham dự — 10 phút
RATE_LIMIT_PAYMENT_REFRESH=5         # làm mới mã thanh toán — 10 phút
RATE_LIMIT_UPLOAD=120                # tải tệp lên — 1 giờ
RATE_LIMIT_GLOBAL=300                # trần chung cho /api — 1 phút
MAX_CHECKINS_PER_INVITATION=2000
