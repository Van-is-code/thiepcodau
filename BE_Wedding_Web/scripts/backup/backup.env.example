# thiep-backup — cấu hình. Copy sang /etc/thiep-backup/backup.env rồi điền.
#   cp scripts/backup/backup.env.example /etc/thiep-backup/backup.env
#   chmod 600 /etc/thiep-backup/backup.env
# File này chứa BÍ MẬT (mật khẩu DB, token). KHÔNG commit.

# ===== Ứng dụng =====
# Thư mục chứa BE_Wedding_Web/ và FE_Wedding_Web/
APP_DIR=/opt/thiepcodau
# Thư mục file cần sao lưu (cách nhau bằng khoảng trắng). Mặc định = uploads + media của BE.
UPLOADS_DIRS=/opt/thiepcodau/BE_Wedding_Web/uploads /opt/thiepcodau/BE_Wedding_Web/media

# ===== PostgreSQL =====
# pg_dump / psql đọc trực tiếp các biến PG* này.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=thiep_backup
PGPASSWORD=
PGDATABASE=Wedding_Web
# Nếu Postgres chạy trong Docker và KHÔNG mở cổng ra host, điền tên container ở đây
# (khi đó script dùng: docker exec <container> pg_dump ...). Để trống nếu kết nối TCP được.
PG_DOCKER_CONTAINER=

# ===== restic + rclone (Google Drive) =====
# Sau khi chạy: rclone config  (tạo remote tên "gdrive")
RCLONE_CONFIG=/etc/thiep-backup/rclone.conf
RESTIC_REPOSITORY=rclone:gdrive:thiepcodau/restic
RESTIC_PASSWORD_FILE=/etc/thiep-backup/restic.pass
# (thay cho RESTIC_PASSWORD_FILE nếu muốn để thẳng — kém an toàn hơn)
# RESTIC_PASSWORD=
# Nếu rclone.conf được đặt mật khẩu:
# RCLONE_CONFIG_PASS=

# ===== Bản DB "mới nhất" để cứu nhanh (tuỳ chọn, khuyến nghị bật) =====
# Cú pháp rclone (KHÔNG có tiền tố "rclone:"). Mỗi lần backup ghi đè db.dump.gz ở đây.
LATEST_DEST=gdrive:thiepcodau/latest

# ===== Lịch & giữ =====
WATCH_INTERVAL=60        # giây giữa 2 lần kiểm thay đổi
MIN_INTERVAL=300         # giây tối thiểu giữa 2 backup do-thay-đổi (điều tiết)
ANCHOR_HOUR=3            # giờ chạy backup mốc ngày (0-23)
KEEP_WITHIN=72h          # giữ MỌI snapshot trong 3 ngày
KEEP_DAILY=14            # + 1/ngày cho 14 ngày (gần như free nhờ dedup); để trống = tắt

# ===== Đường dẫn nội bộ =====
STATE_FILE=/var/lib/thiep-backup/state
LOCK_FILE=/var/lib/thiep-backup/lock
WORK_ROOT=/tmp
BACKUP_TAG=thiepcodau
# BACKUP_HOSTNAME=vps-1

# ===== Cảnh báo =====
# healthchecks.io: ping URL khi xong, URL+"/fail" khi lỗi. Nó tự báo khi bạn NGỪNG ping.
HEALTHCHECK_URL=
# Gửi thẳng Telegram khi backup lỗi (dùng lại bot Lỗi của app cũng được)
TG_ALERT_BOT_TOKEN=
TG_ALERT_CHAT_ID=
